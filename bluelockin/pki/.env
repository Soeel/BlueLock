# Version de HashiCorp Vault
VAULT_VERSION=1.17.3

# Adresse Vault (utilisée par les scripts)
VAULT_ADDR=https://127.0.0.1:8200

# Domaine interne BlueLock
VAULT_DOMAIN=bluelock.local

# IP de la VM2 (pour le SAN du certificat bootstrap)
# Remplacer par l'IP réelle de la VM2 avant le premier déploiement
VAULT_VM_IP=192.168.1.X
