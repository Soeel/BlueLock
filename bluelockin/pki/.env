# Version de Step-CA
STEP_CA_VERSION=0.27.4

# Nom de la CA (affiché dans les certificats)
CA_NAME=BlueLock Intermediate CA

# DNS names sur lesquels la PKI est joignable
# Ajouter l'IP ou hostname réel de VM2
CA_DNS_NAMES=pki.bluelock.local,localhost,127.0.0.1

# Email du provisioner JWK (administrateur PKI)
CA_PROVISIONER_NAME=admin@bluelock.local

# URL de la CA (utilisée par les scripts d'émission)
CA_URL=https://pki.bluelock.local:9000

# Durée de validité des certificats émis (par défaut)
CERT_VALIDITY=8760h
