# =============================================================================
# Bastion BlueLock - modele de configuration. Copier en .env et renseigner.
#   cp .env.example .env   (le .env n'est JAMAIS committe : voir .gitignore)
# =============================================================================

# --- Base de donnees Guacamole (PostgreSQL) ---
POSTGRES_DB=guacamole_db
POSTGRES_USER=guac_user
POSTGRES_PASSWORD=CHANGE_ME_db_strong_password

# --- Annuaire Active Directory (authentification LDAPS des comptes de tier) ---
# Le DC du domaine (FQDN, pas IP, pour valider le certificat LDAPS).
LDAP_HOSTNAME=SRV-DC01.blue.local
LDAP_PORT=636
LDAP_ENCRYPTION_METHOD=ssl
# Base de recherche des utilisateurs et des groupes.
LDAP_USER_BASE_DN=DC=blue,DC=local
LDAP_GROUP_BASE_DN=OU=Groups,DC=blue,DC=local
# Attribut d'identifiant (AD : sAMAccountName ; les admins saisissent admt0x/admt1x/...).
LDAP_USERNAME_ATTRIBUTE=sAMAccountName
LDAP_USER_SEARCH_FILTER=(objectClass=user)
# Compte de service AD en LECTURE SEULE pour le bind (PAS un compte de tier).
LDAP_SEARCH_BIND_DN=CN=svc-guac-ldap,OU=ServiceAccounts,DC=blue,DC=local
LDAP_SEARCH_BIND_PASSWORD=CHANGE_ME_svc_guac_ldap_password

# --- MFA (TOTP pour tous) ---
TOTP_ENABLED=true

# --- Script de synchronisation (sync_bastion_from_tiering.py) ---
# Compte break-glass Guacamole (DB locale) utilise par le script via l'API REST.
GUAC_API_URL=https://bastion.blue.local
GUAC_ADMIN_USER=guacadmin
GUAC_ADMIN_PASSWORD=CHANGE_ME_guacadmin_password
# Chemin du CSV serveurs du tiering (source unique de verite).
TIERING_SERVERS_CSV=../tiering/Configs/servers.csv
