# Version Vault Agent (doit correspondre à la version Vault sur VM2)
VAULT_VERSION=1.17.3

# Version de la stack ELK
STACK_VERSION=8.17.0

# Nom du cluster Elasticsearch
CLUSTER_NAME=bluelock-siem

# Licence (basic ou trial pour les features avancées)
LICENSE=basic

# Mots de passe — À CHANGER avant déploiement
ELASTIC_PASSWORD=BlueLock2025!
KIBANA_PASSWORD=Kibana2025!

# Clé de chiffrement Kibana (min. 32 caractères)
KIBANA_ENCRYPTION_KEY=bluelock-kibana-encryption-key-32c

# Heap JVM pour Elasticsearch (50% de la RAM, max 31g)
ES_HEAP_SIZE=1g
